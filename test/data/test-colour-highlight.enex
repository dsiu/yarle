<note><title>colour highlight</title><content><![CDATA[<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><div><span style="color:rgb(34, 34, 34);">near black body text</span></div><div><span style="color:rgb(128, 128, 128);">grey caption</span></div><div><span style="--en-fontfamily:monospace;font-family:Menlo;">evernote font marker</span></div><div><span style="color:rgb(255, 0, 0);">red warning</span></div><div><span style="background-color: #ffff00;">yellow background</span></div><div><span style="background-color: #ffffff;">white background</span></div><div><span style="-evernote-highlight:true;">evernote highlight</span></div><div><span style="--en-highlight:yellow;"><span style="color:rgb(255, 0, 0);">red inside a highlight</span></span></div></en-note>]]></content><created>20150304T000000Z</created><updated>20150304T000000Z</updated><note-attributes></note-attributes></note>
