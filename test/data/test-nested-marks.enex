<note><title>nested marks</title><content><![CDATA[<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><div><span style="font-weight:bold;">但<span style="font-weight:bold;">是</span>我<span style="font-weight:bold;">們</span>看。</span><br/><span style="font-weight:bold;"><span style="font-weight:bold;">這</span>種寫法。</span></div><div>x <b>outer <strong>inner</strong> tail</b> y</div><div>p <i>slanted <em>again</em> more</i> q</div><div>r <s>gone <del>twice</del></s> t</div><div>use <code>&lt;pre lang="<b>python</b>"&gt;</code> here</div></en-note>]]></content><created>20150304T000000Z</created><updated>20150304T000000Z</updated><note-attributes></note-attributes></note>
