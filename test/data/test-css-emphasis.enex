<note><title>css emphasis</title><content><![CDATA[<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><div>before</div><div style="font-style:italic">Dry mixing colored pencils</div><div style="font-weight: bold;">Bold line one<br/>Bold line two</div><p style="font-weight:700">a bold <b>nested</b> paragraph with <span style="font-weight:normal">a normal part</span> inside</p><div style="font-weight:bold"><div>inner block</div></div><table><tr><td style="font-weight:bold">cell</td><td>plain</td></tr><tr><td>x</td><td>y</td></tr></table><cite style="font-style:normal;font-weight:bold">Author</cite> says<h3 style="font-weight:bold">Heading</h3><div style="font-weight:bold"><a href="http://example.com">a link</a></div><div style="font-weight:normal">not bold</div><div><a href="http://example.com/reply"><span style="font-weight:bold;font-family:FontAwesome"></span>Reply</a></div><div><a href="http://example.com/quote"><span style="font-weight:bold"></span><span></span><span style="font-weight:bold">+</span></a></div><table><tr><td>Head</td></tr><tr><td style="font-weight: bold"><font>多謝！完成。</font></td></tr><tr><td><table><tr><td style="font-weight: bold">地點:</td><td>X</td></tr></table></td></tr><tr><td style="font-weight: bold">完成。</td><td style="font-weight: bold">地點:</td><td>X</td></tr></table><div>after</div></en-note>]]></content><created>20131018T043906Z</created><updated>20131018T043906Z</updated><note-attributes></note-attributes></note>
